# GrabiloBot Environment Variables Configuration

# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Bot username (without @)
BOT_USERNAME=GrabiloBot

# Telegram API ID and Hash from my.telegram.org (Optional - used when deploying local bot API container)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Custom Local Telegram Bot API Server URL (Optional - defaults to official cloud API if left blank)
# If using docker-compose with local api server service: http://telegram-bot-api:8081
TELEGRAM_API_URL=

# Download queue & worker limits
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_TIMEOUT=600

# File size & Media limits (in bytes & seconds)
# Default: 52428800 (50MB) for official cloud API, 2097152000 (2000MB) for local Bot API server
MAX_FILE_SIZE=52428800
MAX_DURATION=7200

# User rate limits (requests per minute)
USER_RATE_LIMIT=5

# Caching duration in seconds (Default: 86400 = 24h)
CACHE_TTL=86400

# Directory paths
TEMP_DIR=./temp
CACHE_DIR=./cache
DB_PATH=./cache/grabilo.db
