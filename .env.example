# GrabiloBot Environment Variables Configuration

# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Bot username (without @)
BOT_USERNAME=GrabiloBot

# Telegram API ID and Hash from https://my.telegram.org (required for the Local Bot API server)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Local Bot API server URL (leave blank to use Telegram's hosted API)
# Native server on this machine: http://127.0.0.1:8081
TELEGRAM_API_URL=

# Download queue & worker limits
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_TIMEOUT=600

# File size & media limits (in bytes & seconds)
# MAX_FILE_SIZE defaults to 50 MB with Telegram's hosted API and 2000 MB with the Local Bot API.
# Uncomment to override that default:
# MAX_FILE_SIZE=2097152000
MAX_DURATION=7200

# User rate limits (requests per minute)
USER_RATE_LIMIT=5

# Caching duration in seconds (Default: 86400 = 24h)
CACHE_TTL=86400

# Directory paths
TEMP_DIR=./temp
CACHE_DIR=./cache
DB_PATH=./cache/grabilo.db
